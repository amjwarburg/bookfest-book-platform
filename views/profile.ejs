<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Profile</title>
  </head>
  <body>
    <%- include('layout'); %>
    <div class="profile-container">
      <div class="profile">
        <img src="/user_1.png" class="profile-image" width="125" height="125" />
        <h3>
          <%= user && user.firstName ? user.firstName : 'User' %> <%= user &&
          user.lastName ? user.lastName : '' %>
        </h3>
        <p><%= user && user.email ? user.email : 'Email' %></p>
      </div>
      <div>
      <h3>Books</h3>
      <% if (readBooks.length === 0) { %>
        <p class="text-muted fst-italic mt-2">No books marked as read yet.</p>
      <% } else { %>
        <div class="row g-4 mt-1">
          <% for (let book of readBooks) { %>
            <div class="col-12 col-sm-6 col-lg-4">
              <div class="card h-100 border-0">
                <a href="/books/info/<%= book.id %>">
                  <img src="<%= book.cover_image %>" alt="<%= book.title %>" style="width: 60%;">
                </a>
                <div class="card-body px-0 pb-0">
                  <p class="fw-bold mb-1" style="font-size: 0.9rem; color: #e0424e;"><%= book.title %></p>
                  <p class="text-muted mb-2" style="font-size: 0.8rem;"><%= book.author %></p>
                  <% if (book.review_text) { %>
                    <p class="mb-0" style="font-size: 0.8rem; color: #555;">
                      &ldquo;<%= book.review_text.length > 120 ? book.review_text.slice(0, 120) + '…' : book.review_text %>&rdquo;
                    </p>
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
      </div>
    </div>
  </body>
</html>
